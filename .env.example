# Copy this file to .env.local and fill in your own DeepSeek API key.
# .env.local is ignored by Git and is only read by the local Vite server.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# Haoee image API. `Authorization` is the raw API key (without `Bearer`).
# The model is selected in the material-agent interface.
IMAGE_API_KEY=your-image-api-key-here
IMAGE_API_BASE_URL=https://maas.haoee.com
IMAGE_API_TIMEOUT_MS=600000
