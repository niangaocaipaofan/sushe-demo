# Copy this file to .env.local and fill in your own DeepSeek API key.
# .env.local is ignored by Git and is only read by the local Vite server.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# Haoee image API. `Authorization` is the raw API key (without `Bearer`).
# The model is selected in the material-agent interface.
IMAGE_API_KEY=your-image-api-key-here
IMAGE_API_BASE_URL=https://maas.haoee.com
IMAGE_API_TIMEOUT_MS=600000

# RunningHub「智慧老人」能力目录。三个工作流的固定契约集中在服务端，以下值可覆盖默认配置。
RUNNINGHUB_API_KEY=your-runninghub-api-key-here
RUNNINGHUB_API_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_POLL_INTERVAL_MS=2000
RUNNINGHUB_UPLOAD_CONCURRENCY=5

RUNNINGHUB_FACE_SWAP_APP_ID=2095062447483871234
RUNNINGHUB_FACE_SWAP_IDENTITY_NODE_ID=81
RUNNINGHUB_FACE_SWAP_MODEL_NODE_ID=76
RUNNINGHUB_FACE_SWAP_PROMPT_NODE_ID=175

RUNNINGHUB_OUTFIT_SWAP_APP_ID=2095060120060391425
RUNNINGHUB_OUTFIT_SWAP_MODEL_NODE_ID=76
RUNNINGHUB_OUTFIT_SWAP_CLOTH_NODE_ID=81
RUNNINGHUB_OUTFIT_SWAP_DESCRIPTION_NODE_ID=176
RUNNINGHUB_OUTFIT_SWAP_PROMPT_NODE_ID=175

RUNNINGHUB_FACE_OUTFIT_SWAP_APP_ID=2095052952716267521
RUNNINGHUB_FACE_OUTFIT_SWAP_IDENTITY_NODE_ID=170
RUNNINGHUB_FACE_OUTFIT_SWAP_MODEL_NODE_ID=76
RUNNINGHUB_FACE_OUTFIT_SWAP_CLOTH_NODE_ID=81
RUNNINGHUB_FACE_OUTFIT_SWAP_DESCRIPTION_NODE_ID=179
RUNNINGHUB_FACE_OUTFIT_SWAP_PROMPT_NODE_ID=175

# 网页先逐文件写入本地素材仓库，任务请求只携带素材 ID。
MATERIAL_ASSET_STORE_PATH=.runtime/material-assets
MATERIAL_ASSET_MAX_BYTES=100000000
MATERIAL_GENERATION_MAX_REQUEST_BYTES=10000000
MATERIAL_GENERATION_CONCURRENCY=10
